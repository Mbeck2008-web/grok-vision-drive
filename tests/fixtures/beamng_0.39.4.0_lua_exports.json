 "beamngpy_set_line": {
  "python": "beamngpy 1.36 api/vehicle/ai.py AIApi.set_line(line: List[Dict[str, Float3 | float]], cling: bool = True): sends {type: 'SetAiLine', line, cling} and waits for the 'AiLineSet' ack",
  "lua_handler": "lua/vehicle/extensions/tech/techCore.lua handleSetAiLine (sha256 e4df96f25591833168fc1c9887886a659705740485f0586699cb85b968f5a948): nodes -> {x, y, z = techUtils.getSurfaceHeight when cling else pos[3], v = speed, radius = 0, radiusOrig = 0}; ai.driveUsingPath({script = nodes, wpSpeeds = speeds}); ai.stateChanged(); sendACK('AiLineSet')",
  "ai_effect": "ai.lua driveUsingPath(script): teleports the vehicle to the first node (vehicleSetPositionRotation, heading node1->node2), mapmgr.setCustomMap() (nil), M.mode = 'manual', stores scriptData; the next ai.updateGFX that has a map runs setScriptedPath: a custom map with nodes wp_1..wp_n, currentRoute from it, setSpeed(nil)/setSpeedMode(nil). A later setMode/setState/spanMap/reset, or a mapmgr map change, clears that route."
 },
